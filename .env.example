# For local mode, HOST defaults to 127.0.0.1; no login is required.
# To expose a public server, set HOST=0.0.0.0 and create a strong APP_PASSWORD.
# HOST=0.0.0.0
# APP_PASSWORD=replace-with-your-own-secret-of-at-least-12-characters
PORT=3000

# Roblox Open Cloud (configure in your hosting service's secret environment variables)
ROBLOX_API_KEY=YOUR_OPEN_CLOUD_API_KEY
ROBLOX_CREATOR_ID=12345678
ROBLOX_CREATOR_TYPE=user

# Optional storage path for a persistent disk on a paid hosting plan
# DATA_DIR=/var/data
